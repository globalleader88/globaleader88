# =============================================================================
# Global Connects Client Intelligence Portal — environment configuration
# Copy to .env for local development. Never commit a real .env.
# In production, source these from AWS Secrets Manager, not a file.
# Validation lives in src/env.ts and refuses to boot on unsafe production config.
# =============================================================================

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ chars. Generate: `openssl rand -base64 48`
SESSION_SECRET=dev-session-secret-change-me-32chars-min!!
LOG_LEVEL=info

# --- Database (PostgreSQL 16 + pgvector) ---
# docker-compose provides this value automatically for the app/worker services.
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal
# DIRECT_URL is used by Prisma migrations when DATABASE_URL points at a pooler.
DIRECT_URL=postgresql://portal:portal@localhost:5432/portal

# --- Authentication ---
# DEV auth verifies a local PBKDF2 hash. MUST be false in production.
ENABLE_DEV_AUTH=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=

# --- AWS core ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Storage ---
# local = filesystem (dev), minio = S3-compatible local, s3 = AWS S3 (prod)
STORAGE_DRIVER=local
AWS_S3_BUCKET=gc-portal-dev
# Required for SSE-KMS in production.
AWS_KMS_KEY_ID=
# For MinIO local dev, e.g. http://localhost:9000
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=.local-storage
PRESIGNED_URL_EXPIRATION_SECONDS=300
MAX_UPLOAD_SIZE_MB=50

# --- AI (Amazon Bedrock) ---
# mock = deterministic offline provider (dev), bedrock = AWS Bedrock (prod)
AI_DRIVER=mock
AWS_BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_BEDROCK_LOW_COST_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_BEDROCK_ADVANCED_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# MUST match the vector(N) dimension in prisma/schema.prisma (default 1024).
AWS_BEDROCK_EMBEDDING_DIMENSION=1024

# --- Cost & limits (seed defaults for new organizations) ---
DEFAULT_MONTHLY_TOKEN_LIMIT=5000000
DEFAULT_DAILY_QUERY_LIMIT=200

# --- Chunking ---
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# --- Response cache (org-isolated; never shared across organizations) ---
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=86400

# --- Rate limiting (public/auth endpoints) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# --- Invitations ---
INVITATION_EXPIRY_HOURS=72

# --- Worker ---
JOB_WORKER_ID=worker-local
# Run the background job worker inside the web process (single-service deploys).
RUN_WORKER_IN_WEB=false

# --- Hosted demo escape hatch (THROWAWAY demos only) ---
# Downgrades production safety guardrails to a warning so the app can boot with
# mock AI + local storage + dev auth. NEVER enable for a real deployment.
ALLOW_INSECURE_DEMO=false

# --- Seed (local dev only) ---
SEED_ADMIN_EMAIL=admin@globalconnects.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
