# ------------------------------------------------------------------
# Global Connects Lead Engine — environment template
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# ------------------------------------------------------------------

# --- Core ---------------------------------------------------------
APP_NAME="Global Connects Lead Engine"
ENVIRONMENT=development            # development | production | test
DEBUG=true

# --- Database (PostgreSQL) ----------------------------------------
# Either set DATABASE_URL directly, OR the POSTGRES_* parts below.
# DATABASE_URL=postgresql+psycopg2://leadengine:leadengine@db:5432/leadengine
POSTGRES_USER=leadengine
POSTGRES_PASSWORD=leadengine        # CHANGE for production
POSTGRES_DB=leadengine
POSTGRES_HOST=db                    # 'db' inside docker-compose; 'localhost' otherwise
POSTGRES_PORT=5432

# --- Admin dashboard / management API (HTTP Basic) ----------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme             # CHANGE THIS before deploying

# --- Website webhook shared secret --------------------------------
# The static assessment site posts leads to /webhook/lead with this secret.
WEBHOOK_SECRET=dev-webhook-secret   # CHANGE THIS; use a long random string

# --- Lead engine tuning -------------------------------------------
DEDUP_THRESHOLD=85                  # 0-100 fuzzy-match cutoff for duplicates

# ==================================================================
# Phase 2 settings
# ==================================================================

# --- Schema management --------------------------------------------
# Production uses Alembic migrations; keep auto-create off there.
AUTO_CREATE_TABLES=true             # set false in production (compose does)

# --- CORS ----------------------------------------------------------
# Comma-separated allowed origins. Use the funnel's domain in production.
CORS_ALLOW_ORIGINS=*                # e.g. https://assessment.theglobalconnects.com

# --- Rate limiting (public webhook) -------------------------------
RATE_LIMIT_ENABLED=true
WEBHOOK_RATE_LIMIT=60               # max requests per window per client IP
WEBHOOK_RATE_WINDOW_SECONDS=60

# --- Integrations --------------------------------------------------
CRM_PROVIDER=none                   # none | log | webhook | (future: gohighlevel)
EMAIL_PROVIDER=none                 # none | log | (future: sendgrid, ses)
ENRICHMENT_PROVIDER=none            # none | log | (future: clearbit, sam_gov)
HOT_LEAD_NOTIFY_THRESHOLD=70        # notify when a lead scores >= this

# Outbound-webhook CRM (set CRM_PROVIDER=webhook to enable). Posts each new
# lead as JSON to this URL — works with Zapier/Make/GoHighLevel inbound hooks.
# CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxx/yyyy
CRM_WEBHOOK_TIMEOUT_SECONDS=5.0

# --- Background jobs -----------------------------------------------
# How post-intake integration dispatch runs:
#   inline = synchronous, in-request (default; simplest, deterministic)
#   thread = background thread pool (keeps intake latency off the path)
JOB_QUEUE=inline
JOB_QUEUE_MAX_WORKERS=4
